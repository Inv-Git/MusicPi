{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicPi",
  "version": "1.1.0",
  "identifier": "fr.clem.music",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MusicPi",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Clem",
    "copyright": "© 2026 Clem",
    "category": "Music",
    "shortDescription": "Lecteur audio haute fidélité",
    "longDescription": "MusicPi, lecteur audio pour bibliothèques FLAC : lecture bit-perfect, enchaînement sans blanc, égaliseur, gestion des tags et des pochettes, mode travail (vitesse et boucle).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "lib/*.dll": "lib/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "MusicPi"
      }
    }
  }
}